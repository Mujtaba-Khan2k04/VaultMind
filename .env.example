# Copy to .env and fill in. NEVER commit .env or share it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-Strong-Password-1

# AI that writes the answers: groq, gemini or offline. Leave LLM_PROVIDER empty to pick from the keys below.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gemini (only if you switch back)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Departments used for department-only documents (comma separated)
DEPARTMENTS=HR,Finance,Engineering
# Optional: seconds to wait for the AI, and fixed secrets (auto-generated into ./data if empty)
# LLM_TIMEOUT=45
# JWT_SECRET=
# VAULT_KEY=
